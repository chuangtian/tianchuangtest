<div class="container container--no-mobile-padding full-width-image full-width-background section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="full-width-image">
 {% style %}
  .container {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
  top: 0;
  left: 0;
  }
  .swiper {
  width: 100vw;
  height: 100vh;
  }

  .swiper-slide {
  position: relative;
  text-align: center;
  font-size: 18px;
  background: #fff;
  height: 100% !important;
  /* Center slide text vertically */
  display: -webkit-box;
  display: -ms-flexbox;
  display: -webkit-flex;
  display: flex;
  -webkit-box-pack: center;
  -ms-flex-pack: center;
  -webkit-justify-content: center;
  justify-content: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  -webkit-align-items: center;
  align-items: center;
  }

  .swiper-slide img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  }

  .txt {
  position: absolute;
  top: 17%;
  }

  .rte {
  margin-bottom: 10px;
  font-size: 36px;
  font-weight: bold;
  }
  .image_href:hover {
  text-decoration: underline;
  }
  .content {
   font-size: 18px;
  }

  .button {
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  bottom: 110px;
  }

  .swiper-button a {
  display: flex;
  align-items: center;
  justify-content: center;
   width: 210px;
   padding: 24px 4px;
   height: 26px;
   border-radius: 6px;
  box-sizing: border-box;
  }
  .swiper-button a:nth-of-type(1) {
   background-color: rgba(0, 0, 0, .8);
   color: #fff;
  }
  .swiper-button a:nth-of-type(2) {
  background-color: rgba(255, 255, 255, .8);
  color: #000;
  margin-left: 15px;
  }
 {% endstyle %}

 <div
  class="full-width relative avoid-overlaps global-border-radius global-border-radius--not-extra-small text-center ">


  {% if section.settings.title != blank %}
   <h2
    class="{% if section.settings.enlarge_title %}giant-title {% else %}large-title {% endif %} rich-text-section__title">{{ section.settings.title | escape }}</h2>
  {% endif %}

  <div class="swiper mySwiper">
   <div class="swiper-wrapper">
    {% for block in section.blocks %}
     <div class="swiper-slide">
      <div class="txt">
       <p class="rte" style="color: {{ block.settings.tab_title_color }}">{{ block.settings.tab_title }}</p>

       {% if block.settings.image_link != blank %}
        <a class="image_href content" style="color: {{ block.settings.tab_title_color }}" href="{{ block.settings.image_link }}">{{ block.settings.tab_content }}</a>
       {% endif %}

       {% if block.settings.image_link == blank %}
        <p style="color: {{ block.settings.tab_content_color }}" class="content">{{ block.settings.tab_content }}</p>
       {% endif %}
      </div>

      <img src="{{ block.settings.image | img_url: '1024x1024' }}" alt="{{ block.settings.image.alt | escape }}" class="rimage__image">

      <div class="swiper-button">
       {% if block.settings.button_title_1 != blank %}
        <a target="_blank" href="{{ block.settings.button_href_1 }}">{{ block.settings.button_title_1 }}</a>
       {% endif %}

       {% if block.settings.button_title_2 != blank %}
        <a target="_blank" href="{{ block.settings.button_href_2 }}">{{ block.settings.button_title_2 }}</a>
       {% endif %}
      </div>
     </div>
    {% endfor %}
   </div>
  </div>
 </div>

 {% schema %}
 {
  "name": "轮播图",
  "tag": "section",
  "class": "section-image-with-text-overlay",
  "max_blocks": 9,
  "blocks": [
   {
    "type": "image",
    "name": "Image",
    "settings": [
     {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "2048 x 1024px recommended"
     },
     {
      "type": "url",
      "id": "image_link",
      "label": "Image link"
     },
     {
      "type": "text",
      "id": "tab_title",
      "label": "Tab Title"
     },
     {
      "type": "text",
      "id": "tab_content",
      "label": "Tab Content"
     },
     {
      "type": "color",
      "id": "tab_title_color",
      "label": "Font Title Color"
     },
     {
      "type": "color",
      "id": "tab_content_color",
      "label": "Font Content Color"
     },
     {
      "type": "text",
      "id": "button_title_1",
      "label": "Button Title 1"
     },
     {
      "type": "text",
      "id": "button_title_2",
      "label": "Button Title 2"
     },
     {
      "type": "url",
      "id": "button_href_1",
      "label": "Button Link 1"
     },
     {
      "type": "url",
      "id": "button_href_2",
      "label": "Button Link 2"
     }
    ]
   }
  ],
  "presets": [
   {
    "name": "Sample index"
   }
  ]
 }
 {% endschema %}
</div>
<script>
 window.onload = function () {
  let swiper = new Swiper(".mySwiper", {
   direction: "vertical",
   mousewheel: true,
   speed: 1500,
   freeMode: false,
   allowTouchMove: /Mobi|Android|iPhone/i.test(navigator.userAgent)
  });
 }
</script>